<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.my.sir.mpdclock"
    android:versionCode="18"
    android:versionName="1.17">

    <!-- Dibutuhkan untuk membaca kekuatan sinyal & info jaringan tiap SIM -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Dibutuhkan untuk membaca info band sel (CellInfo dikategorikan data lokasi) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Izin khusus: statistik pemakaian data bulanan (diaktifkan manual di Pengaturan > Akses penggunaan) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".CrashApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.JamDigital"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Mode launcher: bisa dipilih sebagai aplikasi Home agar
                     otomatis terbuka setiap HP dinyalakan -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
