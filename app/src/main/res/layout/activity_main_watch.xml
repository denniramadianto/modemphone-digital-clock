<?xml version="1.0" encoding="utf-8"?>
<!-- Layout SMARTWATCH: jam di tengah ala watch face, complications di sekeliling -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Complication atas: tanggal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dayNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KAMIS"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateDayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="01"
                android:textColor="#BBBBBB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dateMonthText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="10"
                android:textColor="#BBBBBB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dateYearText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="2026"
                android:textColor="#BBBBBB"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:id="@+id/dividerTop"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#333333" />

        <!-- Baris tengah: SIM1 | JAM | SIM2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Complication kiri: SIM 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sim1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIM 1"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <id.my.sir.mpdclock.SignalBarsView
                    android:id="@+id/sim1Bars"
                    android:layout_width="52dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:id="@+id/sim1Dbm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="- dBm"
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/sim1Band"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Jam tengah -->
            <LinearLayout
                android:id="@+id/clockBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <id.my.sir.mpdclock.SegmentDisplayView
                    android:id="@+id/hourView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/colonView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:text=":"
                    android:textColor="@android:color/white"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <id.my.sir.mpdclock.SegmentDisplayView
                    android:id="@+id/minView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <id.my.sir.mpdclock.SegmentDisplayView
                    android:id="@+id/secView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.32" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/amText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AM"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pmText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="PM"
                        android:textColor="#555555"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Complication kanan: SIM 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sim2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIM 2"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <id.my.sir.mpdclock.SignalBarsView
                    android:id="@+id/sim2Bars"
                    android:layout_width="52dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:id="@+id/sim2Dbm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="- dBm"
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/sim2Band"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Complication bawah: jaringan + trafik + suhu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/netBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_outline"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="4G"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/ledDown"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:alpha="0.25"
                android:background="@drawable/led_green" />

            <TextView
                android:id="@+id/dlSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="↓ -"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/ledUp"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:alpha="0.25"
                android:background="@drawable/led_yellow" />

            <TextView
                android:id="@+id/ulSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="↑ -"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dataUsageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="Data -"
                android:textColor="#888888"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_outline"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="--°C"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
